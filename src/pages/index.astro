---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { getRelativeLocaleUrl } from "astro:i18n";
import Card from "@/components/Card.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import Layout from "@/layouts/Layout.astro";
import config from "@/config";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getPostUrl } from "@/utils/getPostPaths";
import vegas from "@/assets/blog/dbt-summit-2026-01-departure-arrival/dbt-summit-2026-402.jpeg";

const locale = Astro.currentLocale ?? config.site.lang;
const posts = getSortedPosts(await getCollection("posts"));
const featured = posts.find(post => post.data.featured) ?? posts[0];
const url = (path: string) => getRelativeLocaleUrl(locale, path);
const summitPosts = posts.filter(post =>
  post.data.tags.includes("dbt-summit-2026")
);
---

<Layout>
  <Header />
  <main id="main-content" class="journal-layout" data-home-path={url("")}>
    <aside class="journal-sidebar" aria-label="블로그 탐색">
      <a class="sidebar-search" href={url("search")}
        ><span>글 검색하기</span><span aria-hidden="true">⌕</span></a
      >
      <nav aria-label="글 카테고리">
        <h2 class="journal-label">글 카테고리</h2>
        {
          summitPosts.length > 0 && (
            <a class="sidebar-link" href={url("tags/dbt-summit-2026")}>
              <span>dbt Summit 2026</span>
              <span>{summitPosts.length}</span>
            </a>
          )
        }
      </nav>
    </aside>

    <div class="journal-content">
      <h1 class="sr-only">블로그 글</h1>

      {
        featured && (
          <section class="featured-section" aria-labelledby="featured-heading">
            <div class="section-caption">
              <>
                <h2 id="featured-heading" class="journal-label">
                  FEATURED STORY
                </h2>
                <span>먼저 읽어보세요</span>
              </>
            </div>
            <a
              class="featured-story"
              href={getPostUrl(featured.id, featured.filePath, locale)}
            >
              {featured.id === "dbt-summit-2026-01-departure-arrival" && (
                <div class="featured-photo">
                  <Image
                    src={vegas}
                    alt="분수 너머로 보이는 라스베이거스 에펠탑의 야경"
                    widths={[480, 800, 1200]}
                    sizes="(max-width: 760px) 100vw, 800px"
                    loading="eager"
                    fetchpriority="high"
                  />
                  <span class="photo-location">LAS VEGAS, NEVADA ↗</span>
                </div>
              )}
              <div class="featured-copy">
                <div class="story-meta">
                  <>
                    <span>
                      {featured.data.tags.includes("dbt-summit-2026")
                        ? "DBT SUMMIT 2026 · 출장 기록"
                        : "추천 기록"}
                    </span>
                    <time datetime={featured.data.pubDatetime.toISOString()}>
                      {featured.data.pubDatetime.toLocaleDateString("ko-KR", {
                        timeZone: config.site.timezone,
                      })}
                    </time>
                  </>
                </div>
                <h3>{featured.data.title}</h3>
                <p>{featured.data.description}</p>
                <span class="read-story">
                  이야기 읽기 <span aria-hidden="true">↗</span>
                </span>
              </div>
            </a>
          </section>
        )
      }

      <section class="journal-latest" aria-labelledby="latest-heading">
        <div class="section-caption">
          <h2 id="latest-heading">
            최근 기록 <span class="post-count">{posts.length}</span>
          </h2><a href={url("posts")}>전체 보기 ↗</a>
        </div>
        {
          posts.length ? (
            <ul>
              {posts.slice(0, 6).map(post => (
                <Card variant="h3" {...post} />
              ))}
            </ul>
          ) : (
            <p class="empty-note">
              첫 번째 기록을 준비하고 있습니다. 곧 이곳에서 만나요.
            </p>
          )
        }
      </section>

      {
        summitPosts.length > 0 && (
          <a class="series-banner" href={url("tags/dbt-summit-2026")}>
            <div>
              <>
                <span class="journal-label">FIELD NOTES / 2026</span>
                <h2>dbt Summit, 그곳에서의 기록</h2>
                <p>출국부터 컨퍼런스, 돌아와 남기는 생각까지.</p>
              </>
            </div>
            <span class="series-arrow" aria-hidden="true">
              ↗
            </span>
          </a>
        )
      }
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const path =
      document.querySelector<HTMLElement>("[data-home-path]")?.dataset.homePath;
    if (path) sessionStorage.setItem("backUrl", path);
  });
</script>
